# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to version control.

# SQLite database file. This creates a single file (resume_analyzer.db)
# inside the backend/ folder — no separate database server needed.
DATABASE_URL=sqlite:///./resume_analyzer.db

# Groq API key (get one from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key

# Secret key used to sign JWT tokens. Use a long random string.
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your_secret_key
